# Local LM Studio / llama.cpp inference timeouts and compact layout JSON budgets.
# Copy to .env.local and restart the app server. Values are milliseconds/tokens.
LOCAL_VLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_VLM_TIMEOUT_MS=600000
LOCAL_VLM_VISUAL_REVIEW_TIMEOUT_MS=600000
LOCAL_VLM_VISUAL_REVIEW_MAX_TOKENS=2048
LOCAL_VLM_VISUAL_REVIEW_KNOWLEDGE_CHARS=4200
# Compact budgets for screenshot-to-layout extraction; Qwen3.8 is hard-capped in code too.
LOCAL_VLM_MAX_TOKENS=768
LOCAL_VLM_RETRY_MAX_TOKENS=512
LOCAL_VLM_FINAL_MAX_TOKENS=384
LOCAL_VLM_KNOWLEDGE_CHARS=700
